{
  "name": "bindery",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Bindery: self-hosted builder for routed, bilingual learning-book sites",
  "workspaces": [
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "dev:server": "node --watch apps/server/src/index.js",
    "dev:client": "npm run dev --workspace apps/client",
    "build": "npm run build --workspace apps/client",
    "start": "node apps/server/src/index.js",
    "test": "node --test",
    "backup": "node apps/server/scripts/backup.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "fsevents@2.3.3": true
  }
}
