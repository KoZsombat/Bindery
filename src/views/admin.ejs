<%- include('partials/head', { title: t('Admin') + ' · ' + t('Learning Book Builder') }) %>
<section class="page-head">
  <div>
    <div class="kicker"><%= t('Admin') %></div>
    <h1><%= t('Users') %></h1>
    <p class="lead"><%= t('Only the administrator can create accounts. Each user has a daily site limit.') %></p>
  </div>
</section>
<% if (error) { %><div class="inline-err"><%= error %></div><% } %>
<% if (ok) { %><div class="notice"><%= ok %></div><% } %>

<form class="card form" method="post" action="/admin/users">
  <h2><%= t('Add user') %></h2>
  <div class="grid">
    <div><label><%= t('Email') %></label><input name="email" type="email" required></div>
    <div><label><%= t('Name') %></label><input name="name"></div>
    <div><label><%= t('Password (8+)') %></label><input name="password" type="password" required></div>
    <div><label><%= t('Sites per day') %></label><input name="dailyLimit" type="number" min="0" max="1000" value="3"></div>
  </div>
  <button class="btn primary" type="submit" style="margin-top:12px"><%= t('Create user') %></button>
</form>

<div class="card">
  <h2><%= t('Existing users') %></h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th><%= t('Email') %></th><th><%= t('Name') %></th><th><%= t('Limit') %></th><th><%= t('Used today') %></th><th><%= t('Status') %></th><th><%= t('Actions') %></th></tr></thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <td><%= u.email %><% if (u.role === 'admin') { %> <span class="pill"><%= t('admin') %></span><% } %></td>
            <td><%= u.name %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>/limit" class="inline">
                <input class="mini-input" name="dailyLimit" type="number" min="0" max="1000" value="<%= u.daily_limit %>">
                <button class="btn sm" type="submit"><%= t('Save') %></button>
              </form>
            </td>
            <td><%= u.usedToday %></td>
            <td><% if (u.disabled) { %><span class="status failed"><%= t('disabled') %></span><% } else { %><span class="status ready"><%= t('active') %></span><% } %></td>
            <td class="actions">
              <form method="post" action="/admin/users/<%= u.id %>/password" class="inline">
                <input class="mini-input" name="password" type="password" placeholder="<%= t('New password (8+)') %>" minlength="8">
                <button class="btn sm" type="submit"><%= t('Reset') %></button>
              </form>
              <% if (u.role !== 'admin') { %>
                <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline">
                  <button class="btn sm <%= u.disabled ? '' : 'danger' %>" type="submit"><%= t(u.disabled ? 'Enable' : 'Disable') %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/foot') %>
