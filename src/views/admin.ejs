<%- include('partials/head', { title: 'Admin · Learning Book Builder' }) %>
<section class="page-head">
  <div>
    <div class="kicker">Admin</div>
    <h1>Users</h1>
    <p class="lead">Only the administrator can create accounts. Each user has a daily site limit.</p>
  </div>
</section>
<% if (error) { %><div class="inline-err"><%= error %></div><% } %>
<% if (ok) { %><div class="notice"><%= ok %></div><% } %>

<form class="card form" method="post" action="/admin/users">
  <h2>Add user</h2>
  <div class="grid">
    <div><label>Email</label><input name="email" type="email" required></div>
    <div><label>Name</label><input name="name"></div>
    <div><label>Password (8+)</label><input name="password" type="password" required></div>
    <div><label>Sites per day</label><input name="dailyLimit" type="number" min="0" max="1000" value="3"></div>
  </div>
  <button class="btn primary" type="submit" style="margin-top:12px">Create user</button>
</form>

<div class="card">
  <h2>Existing users</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Email</th><th>Name</th><th>Limit</th><th>Used today</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <td><%= u.email %><% if (u.role === 'admin') { %> <span class="pill">admin</span><% } %></td>
            <td><%= u.name %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>/limit" class="inline">
                <input class="mini-input" name="dailyLimit" type="number" min="0" max="1000" value="<%= u.daily_limit %>">
                <button class="btn sm" type="submit">Save</button>
              </form>
            </td>
            <td><%= u.usedToday %></td>
            <td><% if (u.disabled) { %><span class="status failed">disabled</span><% } else { %><span class="status ready">active</span><% } %></td>
            <td class="actions">
              <form method="post" action="/admin/users/<%= u.id %>/password" class="inline">
                <input class="mini-input" name="password" type="password" placeholder="New password (8+)" minlength="8">
                <button class="btn sm" type="submit">Reset</button>
              </form>
              <% if (u.role !== 'admin') { %>
                <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline">
                  <button class="btn sm <%= u.disabled ? '' : 'danger' %>" type="submit"><%= u.disabled ? 'Enable' : 'Disable' %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/foot') %>
