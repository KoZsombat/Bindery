<%- include('partials/head', { title: t('Sites') + ' · ' + t('Learning Book Builder') }) %>
<section class="launchpad">
  <div class="launch-copy">
    <div class="kicker"><%= t('Your workspace') %></div>
    <h1><%= t('Learning sites') %></h1>
    <p class="lead"><%= t('Create a routed book from files and long text. Every site is served at its own URL — nothing to download.') %></p>
    <div class="launch-actions">
      <a class="btn primary" href="/new"><%= t('Start a new book') %></a>
      <a class="btn" href="/catalog"><%= t('Browse catalog') %></a>
      <a class="btn" href="/settings"><%= t('Settings') %></a>
    </div>
  </div>
  <div class="launch-stats">
    <div class="stat"><b><%= remaining %></b><span><%= t('sites left today') %></span></div>
    <div class="stat"><b><%= sites.length %></b><span><%= t('sites in workspace') %></span></div>
    <div class="stat"><b><%= usedToday %> / <%= profile.daily_limit %></b><span><%= t('used today') %></span></div>
  </div>
</section>

<div class="quota">
  <div><b><%= remaining %></b>&nbsp;<span><%= t('of') %> <%= profile.daily_limit %> <%= t('sites left today') %></span></div>
  <div class="bar"><i style="width:<%= profile.daily_limit ? Math.round(usedToday / profile.daily_limit * 100) : 0 %>%"></i></div>
</div>

<div class="grid">
  <% if (!sites.length) { %>
    <div class="empty"><%= t('No sites yet.') %> <a href="/new"><%= t('Create the first one') %></a>.</div>
  <% } %>
  <% sites.forEach(function (s) { %>
    <article class="site-card">
      <div class="site-top"><h3><%= s.title %></h3><span class="status <%= s.status %>"><%= t(s.status) %></span></div>
      <p class="muted"><%= s.description || '' %></p>
      <div class="site-meta">
        <span><%= s.slug %></span><span><%= fmt(s.createdAt) %></span>
        <% if (s.example) { %><span class="pill"><%= t('example') %></span><% } %>
        <% if (!s.published) { %><span class="pill"><%= t('private') %></span><% } %>
      </div>
      <div class="site-actions">
        <% if (s.status === 'ready') { %><a class="btn primary sm" href="<%= s.url %>"><%= t('Open') %></a><% } %>
        <% if (s.reusable) { %>
          <form method="post" action="/site/<%= s.id %>/clone" class="inline"><button class="btn sm" type="submit"><%= t('Reuse') %></button></form>
        <% } %>
        <a class="btn sm" href="/site/<%= s.id %>"><%= t('Details') %></a>
        <% if (s.status === 'queued' || s.status === 'running') { %><span class="muted small"><%= t('generating…') %></span><% } %>
      </div>
      <% if (s.error) { %><div class="inline-err"><%= s.error %></div><% } %>
    </article>
  <% }) %>
</div>
<div class="notice"><%= t('The MatekBázis example is a complete project that was already created. Open it to see the target quality.') %></div>
<%- include('partials/foot') %>
