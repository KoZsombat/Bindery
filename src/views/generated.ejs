<!doctype html>
<html lang="hu">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#052a4b">
<title><%= site.title %> — Learning book</title>
<link rel="icon" href="favicon.svg?v=2" type="image/svg+xml">
<link rel="stylesheet" href="/shared/katex/katex.min.css">
<link rel="stylesheet" href="styles.css?v=2">
</head>
<body>
<header class="top">
  <a class="brand" href="#" id="brandLink">
    <span class="brand-mark" aria-hidden="true">LB</span>
    <span class="brand-text">
      <span class="brand-kicker">Learning book</span>
      <b id="siteTitle"><%= site.title %></b>
      <small id="siteSubtitle"></small>
    </span>
  </a>
  <div class="tools">
    <label class="search"><span class="sr">Search</span><input id="searchInput" type="search" placeholder="Search…" autocomplete="off"></label>
    <button class="chip" id="langBtn" type="button">EN</button>
  </div>
  <div class="progress" title="Reading progress"><i id="progressBar"></i></div>
</header>
<div class="layout">
  <aside class="side">
    <div class="side-head">
      <div class="side-label" id="tocLabel">Contents</div>
      <span class="side-count" id="sideCount"></span>
    </div>
    <nav id="toc"></nav>
  </aside>
  <main id="main" class="main"><p class="muted">Loading…</p></main>
</div>
<footer class="foot"><span id="footTitle"></span> · <span id="footNote">generated with Learning Book Builder</span></footer>
<script>window.__SITE__ = <%- json %>;</script>
<script src="/shared/katex/katex.min.js"></script>
<script src="/shared/katex/auto-render.min.js"></script>
<script src="app.js?v=2"></script>
</body>
</html>
