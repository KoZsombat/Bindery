# Public hostname and generated-site hostnames
BASE_DOMAIN=example.com
SITE_DOMAIN=sites.example.com

# HTTP port. Docker Compose sets 8080 too.
PORT=8080

# First admin. Created only when the users table is empty.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Better Auth signing secret. Generate with: openssl rand -base64 32
# ENCRYPTION_KEY is used as a fallback for both Better Auth and API-key encryption.
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=https://builder.example.com
ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key

# Optional server-wide model key. Users may bring their own key instead.
# Aliases accepted: COMMAND_CODE_API_KEY, COMMAND_CODE_BASE_URL, COMMAND_CODE_MODEL.
LLM_BASE_URL=https://api.commandcode.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1

# Quotas. Admins get a higher default; per-user limits are editable.
DEFAULT_DAILY_LIMIT=3
ADMIN_DAILY_LIMIT=100

# How many generations may run at the same time (I/O bound; default 3).
MAX_CONCURRENT_JOBS=3
# Retry a failed generation once, and recover jobs whose worker lease expired.
MAX_JOB_ATTEMPTS=2
JOB_LEASE_MS=600000
# Uploads stream to disk; cap concurrent multipart requests (default 4).
MAX_CONCURRENT_UPLOADS=4
# Short session cache to avoid a SQLite lookup for every static asset.
SESSION_CACHE_MS=15000

# Share the session cookie across generated subdomains.
# Set to .example.com when using <slug>.sites.example.com.
COOKIE_DOMAIN=
COOKIE_SECURE=0

# Set to 1 for a deterministic sample site without calling an LLM.
# 1 = always mock, 0 = require a key, empty = auto-mock in development when no key
LLM_MOCK=
