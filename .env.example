# Public hostname and generated-site hostnames
BASE_DOMAIN=example.com
# Optional. Defaults to sites.<BASE_DOMAIN>.
SITE_DOMAIN=sites.example.com

# HTTP port. Docker sets 8080.
PORT=8080
# Local default is ./data. The image uses /data.
# DATA_DIR=./data

# First admin. Created only when no admin exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Signing secret for sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
# Public origin of the builder. Defaults to https://bindery.<BASE_DOMAIN>.
BETTER_AUTH_URL=https://bindery.example.com
# Stable key for API-key encryption. Generate with: openssl rand -base64 32
# Rotating this makes saved per-user API keys unreadable.
ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key

# Default OpenAI-compatible endpoint/model. Each user must add their own API key in Settings.
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Output cap per chapter pass. Lower it if your provider rejects large max_tokens.
# LLM_MAX_TOKENS=32000
# Timeout for one model request, milliseconds (deep bilingual chapters are slow).
# LLM_TIMEOUT_MS=900000
# Allow http and private/loopback provider endpoints (local Ollama, vLLM).
# LLM_ALLOW_PRIVATE_HOSTS=1

# Quotas, counted in book generations per local day. Admins get a higher default;
# per-user limits are editable. Chapter passes and repairs are free.
DEFAULT_DAILY_LIMIT=3
ADMIN_DAILY_LIMIT=100

# How many generations may run at the same time (I/O bound; default 3).
MAX_CONCURRENT_JOBS=3
# Chapters are written in batches after a separate outline pass.
# These seed a fresh install; the admin page can change them at runtime.
# Cap on chapters in one book (default 90, hard cap 180). The outline target also
# scales with the source topic count; one chapter is one idea cluster.
# MAX_BOOK_CHAPTERS=90
# Chapters per model request (default 1: one deep chapter per call).
# CHAPTER_BATCH_SIZE=1
# Chapter calls kept in flight per book (default 4, max 8). Provider latency
# dominates; lower it if the provider rate-limits.
# CHAPTER_CONCURRENCY=4
# Ask the model for this multiple of the minimum word budget (default 1.15),
# so small undershoots do not fail the depth contract.
# CHAPTER_WORD_MARGIN=1.15
# Longest backoff (ms) before retrying a 429/5xx chapter call (default 30000).
# LLM_RETRY_BACKOFF_MAX_MS=30000
# Word-count floors as a share of the nominal budget: EN 0.9, HU 0.8
# (Hungarian conveys the same content in fewer words).
# CHAPTER_BUDGET_TOLERANCE=0.9
# CHAPTER_HU_BUDGET_RATIO=0.8
# Retry a failed generation a few times, and recover jobs whose worker lease expired.
MAX_JOB_ATTEMPTS=4
JOB_LEASE_MS=600000
# Uploads stream to disk; cap concurrent multipart requests (default 4).
MAX_CONCURRENT_UPLOADS=4
# Short session cache to avoid a SQLite lookup for every request.
SESSION_CACHE_MS=15000

# How many reverse-proxy hops to trust for client IPs (Traefik/Cloudflare = 1).
TRUST_PROXY=1

# Share the session cookie across generated subdomains.
# Set to .example.com when using <slug>.sites.example.com.
COOKIE_DOMAIN=
COOKIE_SECURE=0

# Set to 1 for a deterministic sample site without calling an LLM.
# 1 = always mock, empty = every user must add their own API key
LLM_MOCK=
