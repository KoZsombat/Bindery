# Production values for compose.prod.yaml.
#
# Copy to .env.prod next to the compose file, or paste the keys into Launchpad's compose
# variable editor when it asks for ${VAR} placeholders. Never commit .env.prod.

# Public origin of the builder. SITE_ORIGIN must match the browser origin exactly:
# scheme + host, no trailing slash. It is passed to the app as BETTER_AUTH_URL.
# BASE_DOMAIN also builds the default sites.<domain> hostname used by generated books.
BASE_DOMAIN=example.com
SITE_ORIGIN=https://bindery.example.com

# Required by the cloudflared `tunnel` service in compose.prod.yaml. Copy it from the
# tunnel's install command (Zero Trust -> Networks -> Tunnels). The public hostname lives
# on the same page and points at http://bindery:8080 - see deploy.md 3.1. If you route
# through the panel's Traefik instead, create a tunnel with no public hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# First-boot administrator. Only used when the database has no admin yet.
# ADMIN_PASSWORD must be at least 10 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Session signing and API-key encryption. Generate each with: openssl rand -base64 32
# ENCRYPTION_KEY must stay stable across deploys, otherwise saved per-user API keys
# cannot be decrypted and users must re-enter them.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Optional provider defaults. Every user still adds their own API key in Settings.
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_MAX_TOKENS=32000
# LLM_TIMEOUT_MS=900000
# LLM_ALLOW_PRIVATE_HOSTS=1

# Optional quotas and worker limits.
# DEFAULT_DAILY_LIMIT=3
# ADMIN_DAILY_LIMIT=100
# MAX_CONCURRENT_JOBS=3
# MAX_CONCURRENT_UPLOADS=4

# Set when generated books are also served on <slug>.sites.<domain> so the session
# cookie is shared; COOKIE_SECURE is already forced on by compose.prod.yaml.
# COOKIE_DOMAIN=.example.com

# Set to 1 only for a deterministic demo without any model calls.
# LLM_MOCK=1
